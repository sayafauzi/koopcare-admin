PORT=5000
DB_HOST=db
DB_USER=koopcare_user
DB_PASSWORD=koopcarepassword
DB_NAME=koopcare_db
JWT_SECRET=supersecretkoopcarekey_ganti_nanti_saat_production
JWT_EXPIRES_IN=7d

# KoopCare ML inference API
# Use http://host.docker.internal:8000 when this backend runs inside Docker
# and the ML API runs directly on the host machine.
# ML_API_BASE_URL=http://127.0.0.1:8000
# ML_API_TIMEOUT_MS=5000
ML_API_BASE_URL=https://koopcare-mlops-credit-scoring-api-production.up.railway.app
ML_API_TIMEOUT_MS=5000

# WhatsApp (Fonnte)
WHATSAPP_API_KEY=
WHATSAPP_SENDER=

# FITUR OTP Dummy (Hanya untuk Development)
# Aktifkan dengan nilai 'true' jika ingin menggunakan OTP dummy.
USE_DUMMY_OTP=false
